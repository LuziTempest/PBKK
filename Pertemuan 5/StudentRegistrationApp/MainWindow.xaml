<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration"
        Height="720"
        Width="1180"
        MinHeight="650"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="STUDENT REGISTRATION"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,18"/>

                <TextBlock Text="NIM"/>
                <TextBox x:Name="txtNim"/>

                <TextBlock Text="Nama Mahasiswa"/>
                <TextBox x:Name="txtName"/>

                <TextBlock Text="Program Studi"/>
                <ComboBox x:Name="cmbProgramStudy" SelectedValuePath="Content">
                    <ComboBoxItem Content="Teknik Informatika"/>
                    <ComboBoxItem Content="Sistem Informasi"/>
                    <ComboBoxItem Content="Manajemen"/>
                    <ComboBoxItem Content="Akuntansi"/>
                </ComboBox>

                <TextBlock Text="Jenis Kelamin"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                    <RadioButton x:Name="rbMale" Content="Laki-laki" Margin="0,0,20,0"/>
                    <RadioButton x:Name="rbFemale" Content="Perempuan"/>
                </StackPanel>

                <TextBlock Text="Tanggal Lahir"/>
                <DatePicker x:Name="dpBirthDate" Margin="0,4,0,12"/>

                <TextBlock Text="Alamat"/>
                <TextBox x:Name="txtAddress" Height="58" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Nomor Telepon"/>
                <TextBox x:Name="txtPhoneNumber"/>

                <WrapPanel>
                    <Button x:Name="btnSave" Content="Simpan" Click="BtnSave_Click"/>
                    <Button x:Name="btnUpdate" Content="Perbarui" Click="BtnUpdate_Click"
                            IsEnabled="False"/>
                    <Button Content="Reset" Click="BtnReset_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
                <TextBlock Text="DATA MAHASISWA" FontSize="24" FontWeight="Bold"
                           DockPanel.Dock="Left"/>
                <TextBlock x:Name="txtStudentCount" Text="Jumlah Mahasiswa: 0"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Cari:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="txtSearch" Grid.Column="1" Margin="0"
                         ToolTip="Cari berdasarkan NIM, nama, atau program studi"
                         TextChanged="TxtSearch_TextChanged"/>
            </Grid>

            <TabControl Grid.Row="2">
                <TabItem Header="Tabel">
                    <DataGrid x:Name="StudentDataGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single"
                              SelectionChanged="StudentDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NIM" Binding="{Binding Nim}" Width="100"/>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Program Studi" Binding="{Binding ProgramStudy}" Width="160"/>
                            <DataGridTextColumn Header="Jenis Kelamin" Binding="{Binding Gender}" Width="110"/>
                            <DataGridTextColumn Header="Tanggal Lahir"
                                                Binding="{Binding BirthDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                            <DataGridTextColumn Header="Alamat" Binding="{Binding Address}" Width="200"/>
                            <DataGridTextColumn Header="Telepon" Binding="{Binding PhoneNumber}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="ListBox (HOL)">
                    <ListBox x:Name="lstMahasiswa" Padding="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Nim}"/><Run Text=" | "/><Run Text="{Binding Name}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="DimGray">
                                        <Run Text="{Binding ProgramStudy}"/><Run Text=" | "/><Run Text="{Binding Gender}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>

            <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                <Button Content="Edit Pilihan" Click="BtnEdit_Click"/>
                <Button Content="Hapus Pilihan" Click="BtnDelete_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
